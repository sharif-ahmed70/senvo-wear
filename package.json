{
  "name": "senvo-wear",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:storefront": "pnpm --filter @senvo/storefront dev",
    "dev:api": "pnpm --filter @senvo/http... build && node packages/http/dist/development-server.js",
    "dev:admin": "pnpm --filter @senvo/admin dev",
    "dev:pos": "pnpm --filter @senvo/pos dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:run": "turbo test:run",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "node scripts/clean-workspace.mjs",
    "boundary:check": "node scripts/check-boundaries.mjs",
    "verify:migration-encoding": "node scripts/verify-migration-encoding.mjs",
    "verify:prisma-cli-compat": "node scripts/verify-prisma-cli-compat.mjs",
    "prepare:database-integration": "pnpm db:generate && pnpm --filter @senvo/domain build",
    "verify:integration-package-resolution": "node scripts/verify-integration-package-resolution.mjs",
    "db:generate": "turbo db:generate",
    "db:validate": "turbo db:validate",
    "db:migrate:create": "pnpm --filter @senvo/database db:migrate:create",
    "db:migrate:deploy": "pnpm --filter @senvo/database db:migrate:deploy",
    "db:test:start": "node scripts/test-db-compose.mjs start",
    "db:test:stop": "node scripts/test-db-compose.mjs stop",
    "db:test:ensure": "node scripts/ensure-test-databases.mjs",
    "db:test:migrate": "node scripts/run-test-database-command.mjs corepack pnpm --filter @senvo/database exec prisma migrate deploy",
    "db:test:status": "node scripts/run-test-database-command.mjs corepack pnpm --filter @senvo/database exec prisma migrate status",
    "db:test:reset": "node scripts/run-test-database-command.mjs corepack pnpm --filter @senvo/database exec prisma migrate reset --force",
    "db:test:drift": "node scripts/run-test-drift-check.mjs",
    "test:integration": "node scripts/run-test-database-command.mjs corepack pnpm --filter @senvo/database test:integration",
    "test:catalog:integration": "pnpm test:integration",
    "verify:database": "node scripts/verify-database.mjs",
    "verify:generated-client-race": "node scripts/verify-generated-client-race.mjs",
    "verify:sslcommerz-sandbox": "pnpm --filter @senvo/payment-provider exec vitest run sslcommerz.sandbox.test.ts",
    "audit": "pnpm audit --audit-level moderate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "latest",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "pnpm": "11.9.0",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.2",
    "turbo": "2.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9"
  }
}
