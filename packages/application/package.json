{
  "name": "@senvo/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    }
  },
  "browser": {
    "./dist/index.js": "./dist/browser.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests --exclude \"**/*.integration.test.ts\"",
    "test:run": "vitest run --passWithNoTests --exclude \"**/*.integration.test.ts\"",
    "test:integration": "node ../../scripts/run-test-database-command.mjs corepack pnpm exec vitest run --fileParallelism=false src/storefront/storefront-application-service.integration.test.ts src/storefront/storefront-reservation-maintenance-service.integration.test.ts src/storefront/storefront-reservation-normalization-service.integration.test.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@senvo/contracts": "workspace:*",
    "@senvo/database": "workspace:*",
    "@senvo/domain": "workspace:*",
    "@senvo/logger": "workspace:*",
    "@senvo/payment-provider": "workspace:*",
    "@senvo/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
