model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(160)
  code         String             @unique @db.VarChar(64)
  status       OrganizationStatus @default(ACTIVE)
  countryCode  String             @default("BD") @map("country_code") @db.VarChar(2)
  timezone     String             @default("Asia/Dhaka") @db.VarChar(80)
  phone        String?            @db.VarChar(40)
  email        String?            @db.VarChar(254)
  addressLine1 String?            @map("address_line_1") @db.VarChar(240)
  addressLine2 String?            @map("address_line_2") @db.VarChar(240)
  city         String?            @db.VarChar(120)
  district     String?            @db.VarChar(120)
  postalCode   String?            @map("postal_code") @db.VarChar(120)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches       Branch[]
  categories     Category[]
  collections    Collection[]
  colors         Color[]
  mediaAssets    MediaAsset[]
  catalogMediaLinks CatalogMediaLink[]
  posCounters    PosCounter[]
  products       Product[]
  sizes          Size[]
  stockLocations StockLocation[]
  variants       ProductVariant[]
  variantBarcodes VariantBarcode[]
  inventoryMovements InventoryMovement[]
  inventoryMovementLines InventoryMovementLine[]
  inventoryReservations InventoryReservation[]
  inventoryReservationLines InventoryReservationLine[]
  inventoryAllocationPolicies InventoryAllocationPolicy[]
  inventoryAllocationPolicyLocations InventoryAllocationPolicyLocation[]
  salesOrders SalesOrder[]
  salesOrderCommerceProfiles SalesOrderCommerceProfile[]
  salesBooths SalesBooth[]
  salesCounters SalesCounter[]
  salesSessions SalesSession[]
  posCarts PosCart[]
  posCartLines PosCartLine[]
  posCheckoutRecords PosCheckoutRecord[]
  paymentBatches PaymentBatch[]
  paymentLines PaymentLine[]
  salesReceipts SalesReceipt[]
  salesReceiptLines SalesReceiptLine[]
  salesReceiptPayments SalesReceiptPayment[]
  paymentCollections PaymentCollection[]
  paymentCollectionLines PaymentCollectionLine[]
  paymentCollectionReceipts PaymentCollectionReceipt[]
  paymentRefunds PaymentRefund[]
  paymentRefundLines PaymentRefundLine[]
  paymentRefundReceipts PaymentRefundReceipt[]
  onlinePaymentAttempts OnlinePaymentAttempt[]
  providerNotifications ProviderNotification[]
  paymentReconciliations PaymentReconciliation[]
  providerRefunds ProviderRefund[]
  posSaleReturns PosSaleReturn[]
  posSaleReturnLines PosSaleReturnLine[]
  posReturnReceipts PosReturnReceipt[]
  salesOrderLines SalesOrderLine[]
  memberships OrganizationMembership[]
  customerAccounts CustomerAccount[]
  authenticationChallenges AuthenticationChallenge[]
  authenticationSessions AuthenticationSession[]
  workforceAuthenticationSessions WorkforceAuthenticationSession[]
  authenticationRateLimits AuthenticationRateLimit[]
  auditEntries AuditEntry[]
  suppliers    Supplier[]
  purchases    Purchase[]
  purchaseLines PurchaseLine[]
  variantCostStates VariantCostState[]
  inventoryCostEntries InventoryCostEntry[]
  saleLineCostSnapshots SaleLineCostSnapshot[]
  supplierPayments      SupplierPayment[]
  supplierLedgerEntries SupplierLedgerEntry[]
  posRegisterSettlements PosRegisterSettlement[]
  courierConsignments   CourierConsignment[]

  @@map("organizations")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique @db.VarChar(254)
  name      String?    @db.VarChar(160)
  status    UserStatus @default(ACTIVE)
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]
  credentials UserCredential[]
  customerAccounts CustomerAccount[]
  authenticationChallenges AuthenticationChallenge[]
  authenticationSessions AuthenticationSession[]
  workforceAuthenticationSessions WorkforceAuthenticationSession[]
  auditEntries AuditEntry[]
  responsibleBooths SalesBooth[]
  openedSalesSessions SalesSession[]
  completedPosCheckouts PosCheckoutRecord[]
  acceptedPaymentBatches PaymentBatch[]
  acceptedPaymentCollections PaymentCollection[]
  acceptedPaymentRefunds PaymentRefund[]
  resolvedPaymentReconciliations PaymentReconciliation[]
  requestedProviderRefunds ProviderRefund[]
  acceptedPosSaleReturns PosSaleReturn[]
  closedPosSettlements PosRegisterSettlement[] @relation("SettlementClosedBy")
  approvedPosSettlements PosRegisterSettlement[] @relation("SettlementApprovedBy")

  @@index([status])
  @@map("users")
}

model UserCredential {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  provider     IdentityProvider
  identifier   String             @db.VarChar(320)
  passwordHash String?            @map("password_hash") @db.VarChar(1000)
  status       CredentialStatus   @default(ACTIVE)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, identifier])
  @@index([userId, status])
  @@index([status])
  @@map("user_credentials")
}

model CustomerAccount {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  firstName         String                @map("first_name") @db.VarChar(80)
  lastName          String                @map("last_name") @db.VarChar(80)
  phone             String?               @db.VarChar(32)
  emailVerifiedAt   DateTime?             @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt   DateTime?             @map("phone_verified_at") @db.Timestamptz(6)
  marketingConsent  Boolean               @default(false) @map("marketing_consent")
  termsAcceptedAt   DateTime              @map("terms_accepted_at") @db.Timestamptz(6)
  status            CustomerAccountStatus @default(PENDING_VERIFICATION)
  version           Int                   @default(1)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, organizationId])
  @@unique([organizationId, phone])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("customer_accounts")
}

model AuthenticationSession {
  id             String                      @id @default(uuid()) @db.Uuid
  userId         String                      @map("user_id") @db.Uuid
  organizationId String                      @map("organization_id") @db.Uuid
  tokenHash      String                      @unique @map("token_hash") @db.VarChar(64)
  csrfTokenHash  String                      @map("csrf_token_hash") @db.VarChar(64)
  status         AuthenticationSessionStatus @default(ACTIVE)
  rememberMe     Boolean                     @default(false) @map("remember_me")
  expiresAt      DateTime                    @map("expires_at") @db.Timestamptz(6)
  lastUsedAt     DateTime                    @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime?                   @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, organizationId, status])
  @@index([organizationId, expiresAt])
  @@map("authentication_sessions")
}

model WorkforceAuthenticationSession {
  id             String                      @id @default(uuid()) @db.Uuid
  userId         String                      @map("user_id") @db.Uuid
  organizationId String                      @map("organization_id") @db.Uuid
  tokenHash      String                      @unique @map("token_hash") @db.VarChar(64)
  csrfTokenHash  String                      @map("csrf_token_hash") @db.VarChar(64)
  status         AuthenticationSessionStatus @default(ACTIVE)
  rememberMe     Boolean                     @default(false) @map("remember_me")
  expiresAt      DateTime                    @map("expires_at") @db.Timestamptz(6)
  lastUsedAt     DateTime                    @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime?                   @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership   OrganizationMembership @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "workforce_sessions_membership_fkey")

  @@index([userId, organizationId, status], map: "workforce_sessions_user_org_status_idx")
  @@index([organizationId, expiresAt], map: "workforce_sessions_org_expires_idx")
  @@map("workforce_authentication_sessions")
}

model AuthenticationChallenge {
  id             String                        @id @default(uuid()) @db.Uuid
  userId         String?                       @map("user_id") @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  type           AuthenticationChallengeType
  destination    String                        @db.VarChar(320)
  secretHash     String                        @unique @map("secret_hash") @db.VarChar(64)
  status         AuthenticationChallengeStatus @default(ACTIVE)
  attempts       Int                           @default(0)
  maxAttempts    Int                           @default(5) @map("max_attempts")
  resendCount    Int                           @default(0) @map("resend_count")
  nextResendAt   DateTime                      @map("next_resend_at") @db.Timestamptz(6)
  expiresAt      DateTime                      @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime?                     @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, type, destination, status, createdAt], map: "auth_challenges_org_type_dest_status_created_idx")
  @@index([userId, status])
  @@index([expiresAt, status])
  @@map("authentication_challenges")
}

model AuthenticationRateLimit {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  action          String   @db.VarChar(64)
  keyHash         String   @map("key_hash") @db.VarChar(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  attempts        Int      @default(0)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, action, keyHash])
  @@index([organizationId, blockedUntil])
  @@map("authentication_rate_limits")
}

model OrganizationMembership {
  id             String                       @id @default(uuid()) @db.Uuid
  userId         String                       @map("user_id") @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  role           Role
  status         OrganizationMembershipStatus @default(ACTIVE)
  version        Int                          @default(1)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsibleBooths SalesBooth[]
  openedSalesSessions SalesSession[]
  completedPosCheckouts PosCheckoutRecord[]
  acceptedPaymentBatches PaymentBatch[]
  acceptedPaymentCollections PaymentCollection[]
  acceptedPaymentRefunds PaymentRefund[]
  resolvedPaymentReconciliations PaymentReconciliation[]
  requestedProviderRefunds ProviderRefund[]
  acceptedPosSaleReturns PosSaleReturn[]
  workforceAuthenticationSessions WorkforceAuthenticationSession[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("organization_memberships")
}

model AuditEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(120)
  resource       String   @db.VarChar(120)
  resourceId     String   @map("resource_id") @db.Uuid
  metadata       Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, createdAt, id])
  @@index([organizationId, resource, resourceId])
  @@index([userId, createdAt])
  @@map("audit_entries")
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  resource    PermissionResource
  action      PermissionAction
  description String?            @db.VarChar(240)
  status      PermissionStatus   @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([status])
  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(uuid()) @db.Uuid
  role         Role
  permissionId String           @map("permission_id") @db.Uuid
  status       PermissionStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([role, permissionId])
  @@index([permissionId])
  @@index([role, status])
  @@map("role_permissions")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(160)
  code           String       @db.VarChar(64)
  status         BranchStatus @default(ACTIVE)
  type           BranchType   @default(SHOWROOM)
  phone          String?      @db.VarChar(40)
  email          String?      @db.VarChar(254)
  addressLine1   String?      @map("address_line_1") @db.VarChar(240)
  addressLine2   String?      @map("address_line_2") @db.VarChar(240)
  city           String?      @db.VarChar(120)
  district       String?      @db.VarChar(120)
  postalCode     String?      @map("postal_code") @db.VarChar(120)
  countryCode    String       @default("BD") @map("country_code") @db.VarChar(2)
  timezone       String       @default("Asia/Dhaka") @db.VarChar(80)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  posCounters    PosCounter[]
  salesCounters  SalesCounter[]
  stockLocations StockLocation[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("branches")
}

model StockLocation {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  name           String              @db.VarChar(160)
  code           String              @db.VarChar(64)
  type           StockLocationType   @default(WAREHOUSE)
  status         StockLocationStatus @default(ACTIVE)
  isSellable     Boolean             @default(false) @map("is_sellable")
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  sourceInventoryMovements InventoryMovement[] @relation("InventoryMovementSourceLocation")
  destinationInventoryMovements InventoryMovement[] @relation("InventoryMovementDestinationLocation")
  inventoryReservations InventoryReservation[]
  inventoryAllocationPolicyLocations InventoryAllocationPolicyLocation[]
  posSaleReturns PosSaleReturn[]
  purchases Purchase[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, branchId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("stock_locations")
}

model PosCounter {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  name           String           @db.VarChar(160)
  code           String           @db.VarChar(64)
  status         PosCounterStatus @default(ACTIVE)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, branchId])
  @@index([organizationId, status])
  @@map("pos_counters")
}

model Category {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(160)
  slug           String            @db.VarChar(120)
  description    String?           @db.VarChar(2000)
  parentId       String?           @map("parent_id") @db.Uuid
  status         CatalogItemStatus @default(ACTIVE)
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent       Category?    @relation("CategoryHierarchy", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  children     Category[]   @relation("CategoryHierarchy")
  products     Product[]

  @@unique([id, organizationId])
  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
  @@index([organizationId, status])
  @@map("categories")
}

model Collection {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(160)
  slug           String            @db.VarChar(120)
  description    String?           @db.VarChar(2000)
  status         CatalogItemStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  products     ProductCollection[]

  @@unique([id, organizationId])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("collections")
}

model Color {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(160)
  normalizedName String            @map("normalized_name") @db.VarChar(160)
  code           String            @db.VarChar(64)
  hexValue       String?           @map("hex_value") @db.VarChar(7)
  status         CatalogItemStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variants     ProductVariant[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@unique([organizationId, normalizedName])
  @@index([organizationId, status])
  @@map("colors")
}

model Size {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(160)
  code           String            @db.VarChar(64)
  sortOrder      Int               @default(0) @map("sort_order")
  status         CatalogItemStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variants     ProductVariant[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, sortOrder])
  @@index([organizationId, status])
  @@map("sizes")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  name           String        @db.VarChar(160)
  slug           String        @db.VarChar(120)
  productCode    String        @map("product_code") @db.VarChar(64)
  description    String?       @db.VarChar(2000)
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category     Category            @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  collections  ProductCollection[]
  mediaLinks   CatalogMediaLink[]
  variants     ProductVariant[]

  @@unique([id, organizationId])
  @@unique([organizationId, productCode])
  @@unique([organizationId, slug])
  @@index([organizationId, categoryId])
  @@index([organizationId, status])
  @@map("products")
}

model MediaAsset {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  storageKey       String           @map("storage_key") @db.VarChar(500)
  mediaType        MediaType        @default(IMAGE) @map("media_type")
  contentType      String           @map("content_type") @db.VarChar(100)
  byteSize         Int              @map("byte_size")
  altText          String           @map("alt_text") @db.VarChar(240)
  status           MediaAssetStatus @default(ACTIVE)
  idempotencyKey   String           @map("idempotency_key") @db.VarChar(120)
  requestSignature String           @map("request_signature") @db.VarChar(64)
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  catalogLinks CatalogMediaLink[]

  @@unique([id, organizationId])
  @@unique([organizationId, storageKey])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt, id])
  @@map("media_assets")
}

model CatalogMediaLink {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  mediaAssetId   String                 @map("media_asset_id") @db.Uuid
  productId      String                 @map("product_id") @db.Uuid
  productVariantId String?              @map("product_variant_id") @db.Uuid
  role           CatalogMediaRole       @default(PRIMARY)
  sortOrder      Int                    @default(0) @map("sort_order")
  status         CatalogMediaLinkStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mediaAsset   MediaAsset   @relation(fields: [mediaAssetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId, productId, organizationId], references: [id, productId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "catalog_media_links_variant_product_org_fkey")

  @@unique([id, organizationId])
  @@unique([mediaAssetId])
  @@unique([productId], map: "catalog_media_links_one_active_primary_per_product", where: { role: "PRIMARY", status: "ACTIVE" })
  @@index([organizationId, productId, role, status])
  @@index([organizationId, productId, productVariantId, status, sortOrder], map: "catalog_media_links_org_product_variant_status_order_idx")
  @@index([organizationId, mediaAssetId])
  @@map("catalog_media_links")
}

model ProductVariant {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  colorId        String               @map("color_id") @db.Uuid
  sizeId         String               @map("size_id") @db.Uuid
  sku            String               @db.VarChar(80)
  status         ProductVariantStatus @default(ACTIVE)
  sellingPriceMinor Int                @default(0) @map("selling_price_minor")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  color        Color        @relation(fields: [colorId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  size         Size         @relation(fields: [sizeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  inventoryMovementLines InventoryMovementLine[]
  inventoryReservationLines InventoryReservationLine[]
  salesOrderLines SalesOrderLine[]
  barcodes VariantBarcode[]
  posCartLines PosCartLine[]
  posSaleReturnLines PosSaleReturnLine[]
  mediaLinks CatalogMediaLink[]
  purchaseLines PurchaseLine[]
  costState VariantCostState?
  costEntries InventoryCostEntry[]
  saleCostSnapshots SaleLineCostSnapshot[]

  @@unique([id, organizationId])
  @@unique([id, productId, organizationId], map: "product_variants_id_product_org_key")
  @@unique([organizationId, sku])
  @@unique([productId, colorId, sizeId])
  @@index([organizationId, productId])
  @@index([organizationId, status])
  @@map("product_variants")
}

model VariantBarcode {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  productVariantId String        @map("product_variant_id") @db.Uuid
  value            String        @unique @db.VarChar(80)
  type             BarcodeType
  status           BarcodeStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([productVariantId], map: "variant_barcodes_one_active_per_variant_key", where: { status: "ACTIVE" })
  @@index([organizationId, productVariantId, createdAt])
  @@index([organizationId, status])
  @@map("variant_barcodes")
}

model SalesCounter {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  branchId       String?            @map("branch_id") @db.Uuid
  boothId        String?            @map("booth_id") @db.Uuid
  name           String             @db.VarChar(160)
  code           String             @db.VarChar(64)
  type           SalesCounterType
  status         SalesCounterStatus @default(ACTIVE)
  version        Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch       Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  booth        SalesBooth?  @relation(fields: [boothId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  sessions     SalesSession[]
  checkoutRecords PosCheckoutRecord[]
  paymentBatches PaymentBatch[]
  settlements  PosRegisterSettlement[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status, type])
  @@index([organizationId, branchId])
  @@index([organizationId, boothId])
  @@map("sales_counters")
}

model SalesSession {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  counterId      String             @map("counter_id") @db.Uuid
  openedByUserId String             @map("opened_by_user_id") @db.Uuid
  openedAt          DateTime           @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt          DateTime?          @map("closed_at") @db.Timestamptz(6)
  openingFloatMinor Int                @default(0) @map("opening_float_minor")
  status            SalesSessionStatus @default(OPEN)
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  counter          SalesCounter           @relation(fields: [counterId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  openedBy         User                   @relation(fields: [openedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  openedMembership OrganizationMembership @relation(fields: [openedByUserId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  cart             PosCart?
  checkoutRecords  PosCheckoutRecord[]
  paymentBatches   PaymentBatch[]
  settlement       PosRegisterSettlement?

  @@unique([id, organizationId])
  @@unique([counterId], map: "sales_sessions_one_open_per_counter_key", where: { status: "OPEN" })
  @@index([organizationId, status, openedAt])
  @@index([organizationId, openedByUserId])
  @@map("sales_sessions")
}

model PosRegisterSettlement {
  id                           String              @id @default(uuid()) @db.Uuid
  organizationId               String              @map("organization_id") @db.Uuid
  salesSessionId               String              @map("sales_session_id") @db.Uuid
  counterId                    String              @map("counter_id") @db.Uuid
  closedByUserId               String              @map("closed_by_user_id") @db.Uuid
  approvedByUserId             String?             @map("approved_by_user_id") @db.Uuid
  openingFloatMinor            Int                 @map("opening_float_minor")
  expectedCashMinor            Int                 @map("expected_cash_minor")
  actualCashMinor              Int                 @map("actual_cash_minor")
  cashDiscrepancyMinor         Int                 @map("cash_discrepancy_minor")
  expectedMobileBankingMinor   Int                 @map("expected_mobile_banking_minor")
  actualMobileBankingMinor     Int                 @map("actual_mobile_banking_minor")
  mobileBankingDiscrepancyMinor Int                @map("mobile_banking_discrepancy_minor")
  expectedCardMinor            Int                 @map("expected_card_minor")
  actualCardMinor              Int                 @map("actual_card_minor")
  cardDiscrepancyMinor         Int                 @map("card_discrepancy_minor")
  expectedBankTransferMinor    Int                 @map("expected_bank_transfer_minor")
  actualBankTransferMinor      Int                 @map("actual_bank_transfer_minor")
  bankTransferDiscrepancyMinor Int                 @map("bank_transfer_discrepancy_minor")
  expectedTotalMinor           Int                 @map("expected_total_minor")
  actualTotalMinor             Int                 @map("actual_total_minor")
  totalDiscrepancyMinor        Int                 @map("total_discrepancy_minor")
  denominationBreakdown        Json?               @map("denomination_breakdown")
  discrepancyReason            String?             @map("discrepancy_reason") @db.VarChar(1000)
  closingNotes                 String?             @map("closing_notes") @db.VarChar(1000)
  status                       PosSettlementStatus
  closedAt                     DateTime            @map("closed_at") @db.Timestamptz(6)
  createdAt                    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesSession SalesSession @relation(fields: [salesSessionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "pos_register_settlements_session_org_fkey")
  counter      SalesCounter @relation(fields: [counterId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "pos_register_settlements_counter_org_fkey")
  closedBy     User         @relation("SettlementClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "pos_register_settlements_closed_by_fkey")
  approvedBy   User?        @relation("SettlementApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "pos_register_settlements_approved_by_fkey")

  @@unique([id, organizationId], map: "pos_register_settlements_id_org_key")
  @@unique([salesSessionId, organizationId], map: "pos_register_settlements_session_org_key")
  @@index([organizationId, counterId, closedAt], map: "pos_register_settlements_org_counter_closed_idx")
  @@index([organizationId, closedByUserId, closedAt], map: "pos_register_settlements_org_staff_closed_idx")
  @@map("pos_register_settlements")
}

model PosCart {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  salesSessionId String   @map("sales_session_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesSession SalesSession @relation(fields: [salesSessionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  lines        PosCartLine[]
  checkout     PosCheckoutRecord?

  @@unique([id, organizationId])
  @@unique([salesSessionId, organizationId])
  @@index([organizationId, createdAt])
  @@map("pos_carts")
}

model PosCartLine {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  unitPriceMinor   Int      @map("unit_price_minor")
  lineSubtotalMinor Int     @map("line_subtotal_minor")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cart           PosCart        @relation(fields: [cartId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cartId, productVariantId])
  @@index([organizationId, productVariantId])
  @@index([cartId])
  @@map("pos_cart_lines")
}

model PosCheckoutRecord {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  cartId           String            @map("cart_id") @db.Uuid
  salesSessionId   String            @map("sales_session_id") @db.Uuid
  counterId        String            @map("counter_id") @db.Uuid
  staffId          String            @map("staff_id") @db.Uuid
  salesOrderId     String            @map("sales_order_id") @db.Uuid
  idempotencyKey   String            @map("idempotency_key") @db.VarChar(64)
  status           PosCheckoutStatus @default(COMPLETED)
  subtotalMinor    Int               @map("subtotal_minor")
  totalMinor       Int               @map("total_minor")
  completedAt      DateTime          @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cart         PosCart                @relation(fields: [cartId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  salesSession SalesSession           @relation(fields: [salesSessionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  counter      SalesCounter           @relation(fields: [counterId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  staff        User                   @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership   OrganizationMembership @relation(fields: [staffId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  salesOrder   SalesOrder             @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  paymentBatch PaymentBatch?
  receipt      SalesReceipt?
  paymentCollections PaymentCollection[]
  paymentCollectionReceipts PaymentCollectionReceipt[]
  paymentRefunds PaymentRefund[]
  paymentRefundReceipts PaymentRefundReceipt[]
  posSaleReturns PosSaleReturn[]
  posReturnReceipts PosReturnReceipt[]

  @@unique([id, organizationId])
  @@unique([cartId, organizationId])
  @@unique([salesOrderId, organizationId])
  @@unique([organizationId, salesSessionId, idempotencyKey])
  @@index([organizationId, completedAt, id])
  @@index([organizationId, counterId, completedAt])
  @@index([organizationId, staffId, completedAt])
  @@map("pos_checkout_records")
}

model PaymentBatch {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  checkoutId       String?              @map("checkout_id") @db.Uuid
  salesOrderId     String               @map("sales_order_id") @db.Uuid
  salesSessionId   String?              @map("sales_session_id") @db.Uuid
  counterId        String?              @map("counter_id") @db.Uuid
  staffId          String?              @map("staff_id") @db.Uuid
  paymentAttemptId String?              @map("payment_attempt_id") @db.Uuid
  idempotencyKey   String               @map("idempotency_key") @db.VarChar(64)
  requestSignature String               @map("request_signature") @db.Text
  currencyCode     String               @map("currency_code") @db.VarChar(3)
  payableMinor     Int                  @map("payable_minor")
  paidMinor        Int                  @map("paid_minor")
  outstandingMinor Int                 @map("outstanding_minor")
  status           PaymentBalanceStatus
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  checkout     PosCheckoutRecord?      @relation(fields: [checkoutId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_batches_checkout_org_fkey")
  salesOrder   SalesOrder              @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_batches_order_org_fkey")
  salesSession SalesSession?           @relation(fields: [salesSessionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_batches_session_org_fkey")
  counter      SalesCounter?           @relation(fields: [counterId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_batches_counter_org_fkey")
  staff        User?                   @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership   OrganizationMembership? @relation(fields: [staffId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_batches_staff_org_fkey")
  paymentAttempt OnlinePaymentAttempt? @relation(fields: [paymentAttemptId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_batches_attempt_org_fkey")
  lines        PaymentLine[]
  receipt      SalesReceipt?
  collections  PaymentCollection[]

  @@unique([id, organizationId], map: "payment_batches_id_org_key")
  @@unique([checkoutId, organizationId], map: "payment_batches_checkout_org_key")
  @@unique([salesOrderId, organizationId], map: "payment_batches_order_org_key")
  @@unique([paymentAttemptId, organizationId], map: "payment_batches_attempt_org_key")
  @@unique([organizationId, salesSessionId, idempotencyKey], map: "payment_batches_org_session_idem_key")
  @@index([organizationId, createdAt, id], map: "payment_batches_org_created_id_idx")
  @@index([organizationId, counterId, createdAt], map: "payment_batches_org_counter_created_idx")
  @@map("payment_batches")
}

model PaymentLine {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  paymentBatchId String        @map("payment_batch_id") @db.Uuid
  lineNumber     Int           @map("line_number")
  method         PaymentMethod
  amountMinor    Int           @map("amount_minor")
  reference      String?       @db.VarChar(120)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentBatch PaymentBatch @relation(fields: [paymentBatchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_lines_batch_org_fkey")

  @@unique([id, organizationId], map: "payment_lines_id_org_key")
  @@unique([paymentBatchId, lineNumber], map: "payment_lines_batch_line_key")
  @@index([organizationId, method, createdAt], map: "payment_lines_org_method_created_idx")
  @@map("payment_lines")
}

model PaymentCollection {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  checkoutId         String   @map("checkout_id") @db.Uuid
  salesOrderId       String   @map("sales_order_id") @db.Uuid
  paymentBatchId     String   @map("payment_batch_id") @db.Uuid
  acceptedByUserId   String   @map("accepted_by_user_id") @db.Uuid
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(64)
  requestSignature   String   @map("request_signature") @db.Text
  currencyCode       String   @map("currency_code") @db.VarChar(3)
  amountMinor        Int      @map("amount_minor")
  balanceBeforeMinor Int      @map("balance_before_minor")
  balanceAfterMinor  Int      @map("balance_after_minor")
  createdAt          DateTime @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  checkout PosCheckoutRecord @relation(fields: [checkoutId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_collections_checkout_org_fkey")
  salesOrder SalesOrder @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_collections_order_org_fkey")
  paymentBatch PaymentBatch @relation(fields: [paymentBatchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_collections_batch_org_fkey")
  acceptedBy User @relation(fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedMembership OrganizationMembership @relation(fields: [acceptedByUserId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_collections_staff_org_fkey")
  lines PaymentCollectionLine[]
  receipt PaymentCollectionReceipt?

  @@unique([id, organizationId], map: "payment_collections_id_org_key")
  @@unique([organizationId, checkoutId, idempotencyKey], map: "payment_collections_org_checkout_idem_key")
  @@index([organizationId, checkoutId, createdAt, id], map: "payment_collections_org_checkout_created_idx")
  @@index([organizationId, acceptedByUserId, createdAt], map: "payment_collections_org_staff_created_idx")
  @@map("payment_collections")
}

model PaymentCollectionLine {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  collectionId   String        @map("collection_id") @db.Uuid
  lineNumber     Int           @map("line_number")
  method         PaymentMethod
  amountMinor    Int           @map("amount_minor")
  reference      String?       @db.VarChar(120)
  createdAt      DateTime      @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  collection PaymentCollection @relation(fields: [collectionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_collection_lines_collection_org_fkey")

  @@unique([collectionId, lineNumber], map: "payment_collection_lines_collection_line_key")
  @@index([organizationId, collectionId], map: "payment_collection_lines_org_collection_idx")
  @@map("payment_collection_lines")
}

