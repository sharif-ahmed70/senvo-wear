generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BranchType {
  SHOWROOM
  WAREHOUSE
  OFFICE
  FULFILMENT
  HYBRID
}

enum StockLocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockLocationType {
  WAREHOUSE
  SHOWROOM
  QC_HOLD
  DAMAGE_HOLD
  RETURN_HOLD
  TRANSIT
  OTHER
}

enum PosCounterStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CatalogItemStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum InventoryMovementStatus {
  DRAFT
  POSTED
}

enum InventoryReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

enum InventoryAllocationPolicyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InventoryAllocationStrategy {
  PRIORITY_ORDER
}

enum SalesOrderStatus {
  DRAFT
  RESERVED
  CONFIRMED
  CANCELLED
  FULFILLED
}

enum SalesOrderChannel {
  ONLINE
  OFFLINE_STORE
  EVENT_BOOTH
  POS
  MANUAL
}

enum SalesBoothStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum OrganizationMembershipStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum PermissionResource {
  ORGANIZATION
  TEAM
  USER
  CATALOG
  INVENTORY
  RESERVATION
  SALES_ORDER
  SALES
  REPORT
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  CANCEL
  FULFILL
}

enum PermissionStatus {
  ACTIVE
  INACTIVE
}

enum IdentityProvider {
  PASSWORD
  GOOGLE
  MICROSOFT
}

enum CredentialStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(160)
  code         String             @unique @db.VarChar(64)
  status       OrganizationStatus @default(ACTIVE)
  countryCode  String             @default("BD") @map("country_code") @db.VarChar(2)
  timezone     String             @default("Asia/Dhaka") @db.VarChar(80)
  phone        String?            @db.VarChar(40)
  email        String?            @db.VarChar(254)
  addressLine1 String?            @map("address_line_1") @db.VarChar(240)
  addressLine2 String?            @map("address_line_2") @db.VarChar(240)
  city         String?            @db.VarChar(120)
  district     String?            @db.VarChar(120)
  postalCode   String?            @map("postal_code") @db.VarChar(120)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches       Branch[]
  categories     Category[]
  collections    Collection[]
  colors         Color[]
  posCounters    PosCounter[]
  products       Product[]
  sizes          Size[]
  stockLocations StockLocation[]
  variants       ProductVariant[]
  inventoryMovements InventoryMovement[]
  inventoryMovementLines InventoryMovementLine[]
  inventoryReservations InventoryReservation[]
  inventoryReservationLines InventoryReservationLine[]
  inventoryAllocationPolicies InventoryAllocationPolicy[]
  inventoryAllocationPolicyLocations InventoryAllocationPolicyLocation[]
  salesOrders SalesOrder[]
  salesBooths SalesBooth[]
  salesOrderLines SalesOrderLine[]
  memberships OrganizationMembership[]
  auditEntries AuditEntry[]

  @@map("organizations")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique @db.VarChar(254)
  name      String?    @db.VarChar(160)
  status    UserStatus @default(ACTIVE)
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]
  credentials UserCredential[]
  auditEntries AuditEntry[]
  responsibleBooths SalesBooth[]

  @@index([status])
  @@map("users")
}

model UserCredential {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  provider     IdentityProvider
  identifier   String             @db.VarChar(320)
  passwordHash String?            @map("password_hash") @db.VarChar(1000)
  status       CredentialStatus   @default(ACTIVE)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, identifier])
  @@index([userId, status])
  @@index([status])
  @@map("user_credentials")
}

model OrganizationMembership {
  id             String                       @id @default(uuid()) @db.Uuid
  userId         String                       @map("user_id") @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  role           Role
  status         OrganizationMembershipStatus @default(ACTIVE)
  version        Int                          @default(1)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsibleBooths SalesBooth[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("organization_memberships")
}

model AuditEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(120)
  resource       String   @db.VarChar(120)
  resourceId     String   @map("resource_id") @db.Uuid
  metadata       Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, createdAt, id])
  @@index([organizationId, resource, resourceId])
  @@index([userId, createdAt])
  @@map("audit_entries")
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  resource    PermissionResource
  action      PermissionAction
  description String?            @db.VarChar(240)
  status      PermissionStatus   @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([status])
  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(uuid()) @db.Uuid
  role         Role
  permissionId String           @map("permission_id") @db.Uuid
  status       PermissionStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([role, permissionId])
  @@index([permissionId])
  @@index([role, status])
  @@map("role_permissions")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(160)
  code           String       @db.VarChar(64)
  status         BranchStatus @default(ACTIVE)
  type           BranchType   @default(SHOWROOM)
  phone          String?      @db.VarChar(40)
  email          String?      @db.VarChar(254)
  addressLine1   String?      @map("address_line_1") @db.VarChar(240)
  addressLine2   String?      @map("address_line_2") @db.VarChar(240)
  city           String?      @db.VarChar(120)
  district       String?      @db.VarChar(120)
  postalCode     String?      @map("postal_code") @db.VarChar(120)
  countryCode    String       @default("BD") @map("country_code") @db.VarChar(2)
  timezone       String       @default("Asia/Dhaka") @db.VarChar(80)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  posCounters    PosCounter[]
  stockLocations StockLocation[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("branches")
}

model StockLocation {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  name           String              @db.VarChar(160)
  code           String              @db.VarChar(64)
  type           StockLocationType   @default(WAREHOUSE)
  status         StockLocationStatus @default(ACTIVE)
  isSellable     Boolean             @default(false) @map("is_sellable")
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  sourceInventoryMovements InventoryMovement[] @relation("InventoryMovementSourceLocation")
  destinationInventoryMovements InventoryMovement[] @relation("InventoryMovementDestinationLocation")
  inventoryReservations InventoryReservation[]
  inventoryAllocationPolicyLocations InventoryAllocationPolicyLocation[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, branchId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("stock_locations")
}

model PosCounter {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  name           String           @db.VarChar(160)
  code           String           @db.VarChar(64)
  status         PosCounterStatus @default(ACTIVE)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, branchId])
  @@index([organizationId, status])
  @@map("pos_counters")
}

model Category {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(160)
  slug           String            @db.VarChar(120)
  description    String?           @db.VarChar(2000)
  parentId       String?           @map("parent_id") @db.Uuid
  status         CatalogItemStatus @default(ACTIVE)
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent       Category?    @relation("CategoryHierarchy", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  children     Category[]   @relation("CategoryHierarchy")
  products     Product[]

  @@unique([id, organizationId])
  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
  @@index([organizationId, status])
  @@map("categories")
}

model Collection {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(160)
  slug           String            @db.VarChar(120)
  description    String?           @db.VarChar(2000)
  status         CatalogItemStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  products     ProductCollection[]

  @@unique([id, organizationId])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("collections")
}

model Color {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(160)
  normalizedName String            @map("normalized_name") @db.VarChar(160)
  code           String            @db.VarChar(64)
  hexValue       String?           @map("hex_value") @db.VarChar(7)
  status         CatalogItemStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variants     ProductVariant[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@unique([organizationId, normalizedName])
  @@index([organizationId, status])
  @@map("colors")
}

model Size {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(160)
  code           String            @db.VarChar(64)
  sortOrder      Int               @default(0) @map("sort_order")
  status         CatalogItemStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variants     ProductVariant[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, sortOrder])
  @@index([organizationId, status])
  @@map("sizes")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  name           String        @db.VarChar(160)
  slug           String        @db.VarChar(120)
  productCode    String        @map("product_code") @db.VarChar(64)
  description    String?       @db.VarChar(2000)
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category     Category            @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  collections  ProductCollection[]
  variants     ProductVariant[]

  @@unique([id, organizationId])
  @@unique([organizationId, productCode])
  @@unique([organizationId, slug])
  @@index([organizationId, categoryId])
  @@index([organizationId, status])
  @@map("products")
}

model ProductVariant {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  colorId        String               @map("color_id") @db.Uuid
  sizeId         String               @map("size_id") @db.Uuid
  sku            String               @db.VarChar(80)
  status         ProductVariantStatus @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  color        Color        @relation(fields: [colorId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  size         Size         @relation(fields: [sizeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  inventoryMovementLines InventoryMovementLine[]
  inventoryReservationLines InventoryReservationLine[]
  salesOrderLines SalesOrderLine[]

  @@unique([id, organizationId])
  @@unique([organizationId, sku])
  @@unique([productId, colorId, sizeId])
  @@index([organizationId, productId])
  @@index([organizationId, status])
  @@map("product_variants")
}

model ProductCollection {
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  collectionId   String   @map("collection_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product    Product    @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  collection Collection @relation(fields: [collectionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@id([productId, collectionId])
  @@index([organizationId, collectionId])
  @@map("product_collections")
}

model InventoryMovement {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @map("organization_id") @db.Uuid
  movementNumber        String                  @map("movement_number") @db.VarChar(64)
  type                  InventoryMovementType
  status                InventoryMovementStatus @default(DRAFT)
  sourceLocationId      String?                 @map("source_location_id") @db.Uuid
  destinationLocationId String?                 @map("destination_location_id") @db.Uuid
  referenceType         String?                 @map("reference_type") @db.VarChar(80)
  referenceId           String?                 @map("reference_id") @db.VarChar(120)
  idempotencyKey        String                  @map("idempotency_key") @db.VarChar(128)
  payloadSignature      String                  @map("payload_signature") @db.Text
  reversesMovementId    String?                 @map("reverses_movement_id") @db.Uuid
  reversalReason        String?                 @map("reversal_reason") @db.VarChar(1000)
  occurredAt            DateTime                @map("occurred_at") @db.Timestamptz(6)
  postedAt              DateTime?               @map("posted_at") @db.Timestamptz(6)
  note                  String?                 @db.VarChar(1000)
  version               Int                     @default(1)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceLocation      StockLocation?            @relation("InventoryMovementSourceLocation", fields: [sourceLocationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  destinationLocation StockLocation?            @relation("InventoryMovementDestinationLocation", fields: [destinationLocationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  reversesMovement    InventoryMovement?        @relation("InventoryMovementReversal", fields: [reversesMovementId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  reversedByMovements InventoryMovement[]       @relation("InventoryMovementReversal")
  consumedReservation InventoryReservation?     @relation("InventoryReservationConsumption")
  fulfilledSalesOrder SalesOrder?               @relation("SalesOrderFulfillmentMovement")
  lines               InventoryMovementLine[]

  @@unique([id, organizationId])
  @@unique([organizationId, movementNumber])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, reversesMovementId])
  @@index([organizationId, status, occurredAt, id])
  @@index([organizationId, type, occurredAt, id])
  @@index([organizationId, sourceLocationId, occurredAt])
  @@index([organizationId, destinationLocationId, occurredAt])
  @@index([organizationId, reversesMovementId])
  @@map("inventory_movements")
}

model InventoryMovementLine {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  movementId       String   @map("movement_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  lineNumber       Int      @map("line_number")
  note             String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movement       InventoryMovement @relation(fields: [movementId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  productVariant ProductVariant    @relation(fields: [productVariantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([movementId, productVariantId])
  @@unique([movementId, lineNumber])
  @@index([organizationId, productVariantId])
  @@index([movementId])
  @@map("inventory_movement_lines")
}

model InventoryReservation {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String                     @map("organization_id") @db.Uuid
  reservationNumber String                     @map("reservation_number") @db.VarChar(64)
  idempotencyKey    String                     @map("idempotency_key") @db.VarChar(128)
  payloadSignature  String                     @map("payload_signature") @db.Text
  status            InventoryReservationStatus @default(ACTIVE)
  stockLocationId   String                     @map("stock_location_id") @db.Uuid
  referenceType     String?                    @map("reference_type") @db.VarChar(80)
  referenceId       String?                    @map("reference_id") @db.VarChar(120)
  consumedByMovementId String?                 @map("consumed_by_movement_id") @db.Uuid
  expiresAt         DateTime?                  @map("expires_at") @db.Timestamptz(6)
  confirmedAt       DateTime?                  @map("confirmed_at") @db.Timestamptz(6)
  releasedAt        DateTime?                  @map("released_at") @db.Timestamptz(6)
  expiredAt         DateTime?                  @map("expired_at") @db.Timestamptz(6)
  note              String?                    @db.VarChar(1000)
  version           Int                        @default(1)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockLocation StockLocation              @relation(fields: [stockLocationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  consumedByMovement InventoryMovement?    @relation("InventoryReservationConsumption", fields: [consumedByMovementId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  lines         InventoryReservationLine[]
  salesOrder    SalesOrder?                @relation("SalesOrderInventoryReservation")

  @@unique([id, organizationId])
  @@unique([organizationId, reservationNumber])
  @@unique([organizationId, idempotencyKey])
  @@unique([consumedByMovementId, organizationId], map: "inventory_reservations_consumed_by_movement_id_organization_key")
  @@index([organizationId, status, createdAt, id])
  @@index([organizationId, stockLocationId, status])
  @@index([organizationId, referenceType, referenceId])
  @@map("inventory_reservations")
}

model InventoryReservationLine {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  reservationId    String   @map("reservation_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  lineNumber       Int      @map("line_number")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation    InventoryReservation @relation(fields: [reservationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  productVariant ProductVariant       @relation(fields: [productVariantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([reservationId, productVariantId])
  @@unique([reservationId, lineNumber])
  @@index([organizationId, productVariantId])
  @@index([reservationId])
  @@map("inventory_reservation_lines")
}

model InventoryAllocationPolicy {
  id                      String                          @id @default(uuid()) @db.Uuid
  organizationId          String                          @map("organization_id") @db.Uuid
  name                    String                          @db.VarChar(160)
  code                    String                          @db.VarChar(64)
  status                  InventoryAllocationPolicyStatus @default(ACTIVE)
  strategy                InventoryAllocationStrategy     @default(PRIORITY_ORDER)
  requireSellableLocation Boolean                         @default(true) @map("require_sellable_location")
  version                 Int                             @default(1)
  createdAt               DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  locations    InventoryAllocationPolicyLocation[]
  salesOrders   SalesOrder[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status, createdAt, id])
  @@map("inventory_allocation_policies")
}

model InventoryAllocationPolicyLocation {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  policyId        String   @map("policy_id") @db.Uuid
  stockLocationId String   @map("stock_location_id") @db.Uuid
  priority        Int
  isEnabled       Boolean  @default(true) @map("is_enabled")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  policy        InventoryAllocationPolicy @relation(fields: [policyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  stockLocation StockLocation             @relation(fields: [stockLocationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([policyId, stockLocationId])
  @@unique([policyId, priority])
  @@index([organizationId, policyId, priority])
  @@index([organizationId, stockLocationId])
  @@map("inventory_allocation_policy_locations")
}

model SalesOrder {
  id                     String            @id @default(uuid()) @db.Uuid
  organizationId         String            @map("organization_id") @db.Uuid
  orderNumber            String            @map("order_number") @db.VarChar(64)
  status                 SalesOrderStatus  @default(DRAFT)
  channel                SalesOrderChannel
  boothId                String?           @map("booth_id") @db.Uuid
  currencyCode           String            @map("currency_code") @db.VarChar(3)
  subtotalMinor          Int               @map("subtotal_minor")
  discountMinor          Int               @default(0) @map("discount_minor")
  deliveryMinor          Int               @default(0) @map("delivery_minor")
  totalMinor             Int               @map("total_minor")
  customerName           String?           @map("customer_name") @db.VarChar(160)
  customerPhone          String?           @map("customer_phone") @db.VarChar(40)
  customerEmail          String?           @map("customer_email") @db.VarChar(254)
  deliveryAddressLine1   String?           @map("delivery_address_line_1") @db.VarChar(240)
  deliveryAddressLine2   String?           @map("delivery_address_line_2") @db.VarChar(240)
  deliveryCity           String?           @map("delivery_city") @db.VarChar(120)
  deliveryDistrict       String?           @map("delivery_district") @db.VarChar(120)
  deliveryPostalCode     String?           @map("delivery_postal_code") @db.VarChar(120)
  allocationPolicyId     String?           @map("allocation_policy_id") @db.Uuid
  inventoryReservationId String?           @map("inventory_reservation_id") @db.Uuid
  fulfillmentMovementId  String?           @map("fulfillment_movement_id") @db.Uuid
  idempotencyKey         String            @map("idempotency_key") @db.VarChar(128)
  payloadSignature       String            @map("payload_signature") @db.Text
  note                   String?           @db.VarChar(1000)
  version                Int               @default(1)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  reservedAt             DateTime?         @map("reserved_at") @db.Timestamptz(6)
  confirmedAt            DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt            DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  fulfilledAt            DateTime?         @map("fulfilled_at") @db.Timestamptz(6)

  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allocationPolicy     InventoryAllocationPolicy? @relation(fields: [allocationPolicyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  inventoryReservation InventoryReservation?      @relation("SalesOrderInventoryReservation", fields: [inventoryReservationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  fulfillmentMovement  InventoryMovement?         @relation("SalesOrderFulfillmentMovement", fields: [fulfillmentMovementId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  booth                SalesBooth?                 @relation(fields: [boothId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  lines                SalesOrderLine[]

  @@unique([id, organizationId])
  @@unique([organizationId, orderNumber])
  @@unique([organizationId, idempotencyKey])
  @@unique([inventoryReservationId, organizationId], map: "sales_orders_inventory_reservation_id_organization_key")
  @@unique([fulfillmentMovementId, organizationId], map: "sales_orders_fulfillment_movement_id_organization_key")
  @@index([organizationId, status, createdAt, id])
  @@index([organizationId, channel, createdAt, id])
  @@index([organizationId, boothId, createdAt, id])
  @@index([organizationId, customerPhone])
  @@index([organizationId, allocationPolicyId])
  @@index([organizationId, inventoryReservationId])
  @@map("sales_orders")
}

model SalesBooth {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  name               String           @db.VarChar(160)
  location           String           @db.VarChar(240)
  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime         @map("end_date") @db.Date
  responsibleStaffId String           @map("responsible_staff_id") @db.Uuid
  status             SalesBoothStatus @default(ACTIVE)
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsibleStaff      User                   @relation(fields: [responsibleStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsibleMembership OrganizationMembership @relation(fields: [responsibleStaffId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  salesOrders           SalesOrder[]

  @@unique([id, organizationId])
  @@index([organizationId, status, startDate, id])
  @@index([organizationId, responsibleStaffId])
  @@map("sales_booths")
}

model SalesOrderLine {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  salesOrderId        String   @map("sales_order_id") @db.Uuid
  productVariantId    String   @map("product_variant_id") @db.Uuid
  lineNumber          Int      @map("line_number")
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(160)
  skuSnapshot         String   @map("sku_snapshot") @db.VarChar(80)
  colorSnapshot       String?  @map("color_snapshot") @db.VarChar(160)
  sizeSnapshot        String?  @map("size_snapshot") @db.VarChar(160)
  quantity            Int
  unitPriceMinor      Int      @map("unit_price_minor")
  discountMinor       Int      @default(0) @map("discount_minor")
  lineTotalMinor      Int      @map("line_total_minor")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesOrder     SalesOrder     @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([salesOrderId, productVariantId])
  @@unique([salesOrderId, lineNumber])
  @@index([organizationId, productVariantId])
  @@index([salesOrderId])
  @@map("sales_order_lines")
}
