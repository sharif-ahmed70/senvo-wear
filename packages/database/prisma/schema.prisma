  receiptNumber            String               @map("receipt_number") @db.VarChar(64)
  organizationName         String               @map("organization_name") @db.VarChar(160)
  organizationPhone        String?              @map("organization_phone") @db.VarChar(40)
  organizationEmail        String?              @map("organization_email") @db.VarChar(254)
  organizationAddressLine1 String?              @map("organization_address_line_1") @db.VarChar(240)
  organizationAddressLine2 String?              @map("organization_address_line_2") @db.VarChar(240)
  organizationCity         String?              @map("organization_city") @db.VarChar(120)
  organizationDistrict     String?              @map("organization_district") @db.VarChar(120)
  organizationPostalCode   String?              @map("organization_postal_code") @db.VarChar(120)
  orderNumber              String               @map("order_number") @db.VarChar(64)
  acceptedByName           String               @map("accepted_by_name") @db.VarChar(254)
