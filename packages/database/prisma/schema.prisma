  endDate            DateTime         @map("end_date") @db.Date
  responsibleStaffId String           @map("responsible_staff_id") @db.Uuid
  status             SalesBoothStatus @default(ACTIVE)
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsibleStaff      User                   @relation(fields: [responsibleStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsibleMembership OrganizationMembership @relation(fields: [responsibleStaffId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  salesOrders           SalesOrder[]
  salesCounters         SalesCounter[]

  @@unique([id, organizationId])
  @@index([organizationId, status, startDate, id])
  @@index([organizationId, responsibleStaffId])
  @@map("sales_booths")
}

model SalesOrderLine {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  salesOrderId        String   @map("sales_order_id") @db.Uuid
  productVariantId    String   @map("product_variant_id") @db.Uuid
  lineNumber          Int      @map("line_number")
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(160)
  skuSnapshot         String   @map("sku_snapshot") @db.VarChar(80)
  colorSnapshot       String?  @map("color_snapshot") @db.VarChar(160)
  sizeSnapshot        String?  @map("size_snapshot") @db.VarChar(160)
  quantity            Int
  unitPriceMinor      Int      @map("unit_price_minor")
  discountMinor       Int      @default(0) @map("discount_minor")
  lineTotalMinor      Int      @map("line_total_minor")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesOrder     SalesOrder     @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  posSaleReturnLines PosSaleReturnLine[]
  costSnapshot       SaleLineCostSnapshot?

  @@unique([id, organizationId], map: "sales_order_lines_id_org_key")
  @@unique([salesOrderId, productVariantId])
  @@unique([salesOrderId, lineNumber])
  @@index([organizationId, productVariantId])
  @@index([salesOrderId])
  @@map("sales_order_lines")
}

model Supplier {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(160)
  code           String         @db.VarChar(64)
  contactPerson  String?        @map("contact_person") @db.VarChar(160)
  phone          String?        @db.VarChar(40)
  email          String?        @db.VarChar(254)
  address        String?        @db.VarChar(255)
  notes          String?        @db.Text
  status         SupplierStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purchases     Purchase[]
  payments      SupplierPayment[]
  ledgerEntries SupplierLedgerEntry[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@map("suppliers")
}

model Purchase {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @map("organization_id") @db.Uuid
  purchaseNumber        String         @map("purchase_number") @db.VarChar(64)
  supplierId            String         @map("supplier_id") @db.Uuid
  destinationLocationId String         @map("destination_location_id") @db.Uuid
  status                PurchaseStatus @default(DRAFT)
  purchaseDate          DateTime       @map("purchase_date") @db.Timestamptz(6)
  expectedDeliveryDate  DateTime?      @map("expected_delivery_date") @db.Timestamptz(6)
  notes                 String?        @db.Text
  idempotencyKey        String?        @map("idempotency_key") @db.VarChar(128)
  totalCostMinor        BigInt         @default(0) @map("total_cost_minor")
  receiptMovementId     String?        @map("receipt_movement_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier            Supplier           @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  destinationLocation StockLocation      @relation(fields: [destinationLocationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  receiptMovement     InventoryMovement? @relation("PurchaseReceiptMovement", fields: [receiptMovementId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  lines               PurchaseLine[]
  costEntries         InventoryCostEntry[]
  payments            SupplierPayment[]

  @@unique([id, organizationId])
  @@unique([organizationId, purchaseNumber])
  @@unique([organizationId, idempotencyKey])
  @@unique([receiptMovementId, organizationId], map: "purchases_receipt_movement_org_key")
  @@index([organizationId, status, purchaseDate])
  @@index([organizationId, supplierId])
  @@index([organizationId, destinationLocationId])
  @@map("purchases")
}

model PurchaseLine {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  purchaseId       String   @map("purchase_id") @db.Uuid
  lineNumber       Int      @map("line_number")
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  unitCostMinor    Int      @map("unit_cost_minor")
  totalCostMinor   BigInt   @map("total_cost_minor")
  productName      String   @map("product_name") @db.VarChar(160)
  variantName      String?  @map("variant_name") @db.VarChar(160)
  sku              String   @db.VarChar(80)
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purchase       Purchase       @relation(fields: [purchaseId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@unique([purchaseId, lineNumber])
  @@unique([purchaseId, productVariantId])
  @@index([organizationId, productVariantId])
  @@map("purchase_lines")
}

model VariantCostState {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  productVariantId    String             @map("product_variant_id") @db.Uuid
  inventoryValueMinor BigInt             @default(0) @map("inventory_value_minor")
  averageCostMinor    Int?               @map("average_cost_minor")
  isCostKnown         Boolean            @default(false) @map("is_cost_known")
  costUnknownReason   CostUnknownReason? @map("cost_unknown_reason")
  version             Int                @default(1)
  lastCostEventAt     DateTime?          @map("last_cost_event_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@unique([productVariantId, organizationId], map: "variant_cost_states_variant_org_key")
  @@index([organizationId, isCostKnown])
  @@map("variant_cost_states")
}

model InventoryCostEntry {
  id                     String                 @id @default(uuid()) @db.Uuid
  organizationId         String                 @map("organization_id") @db.Uuid
  productVariantId       String                 @map("product_variant_id") @db.Uuid
  eventType              InventoryCostEventType @map("event_type")
  quantityChange         Int                    @map("quantity_change")
  valueChangeMinor       BigInt                 @map("value_change_minor")
  beforeQuantity         Int                    @map("before_quantity")
  afterQuantity          Int                    @map("after_quantity")
  beforeValueMinor       BigInt                 @map("before_value_minor")
  afterValueMinor        BigInt                 @map("after_value_minor")
  beforeAverageCostMinor Int?                   @map("before_average_cost_minor")
  afterAverageCostMinor  Int?                   @map("after_average_cost_minor")
  sourcePurchaseId       String?                @map("source_purchase_id") @db.Uuid
  sourceMovementId       String?                @map("source_movement_id") @db.Uuid
  reference              String?                @db.VarChar(500)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productVariant ProductVariant     @relation(fields: [productVariantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  sourcePurchase Purchase?          @relation(fields: [sourcePurchaseId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  sourceMovement InventoryMovement? @relation(fields: [sourceMovementId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, productVariantId, createdAt])
  @@index([organizationId, eventType, createdAt])
  @@index([organizationId, sourcePurchaseId])
  @@index([organizationId, sourceMovementId])
  @@map("inventory_cost_entries")
}

model SaleLineCostSnapshot {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  salesOrderLineId  String             @map("sales_order_line_id") @db.Uuid
  productVariantId  String             @map("product_variant_id") @db.Uuid
  quantity          Int
  unitCostMinor     Int?               @map("unit_cost_minor")
  totalCostMinor    BigInt?            @map("total_cost_minor")
  isCostKnown       Boolean            @default(false) @map("is_cost_known")
  costUnknownReason CostUnknownReason? @map("cost_unknown_reason")
  costingMethod     CostingMethod      @default(MOVING_WEIGHTED_AVERAGE) @map("costing_method")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@unique([salesOrderLineId, organizationId], map: "sale_line_cost_snapshots_order_line_org_key")
  @@index([organizationId, productVariantId])
  @@map("sale_line_cost_snapshots")
}

model SupplierPayment {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  supplierId     String                @map("supplier_id") @db.Uuid
  purchaseId     String?               @map("purchase_id") @db.Uuid
  amountMinor    BigInt                @map("amount_minor")
  paymentDate    DateTime              @map("payment_date") @db.Timestamptz(6)
  paymentMethod  SupplierPaymentMethod @map("payment_method")
  reference      String?               @db.VarChar(160)
  notes          String?               @db.Text
  idempotencyKey String?               @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier     Supplier     @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  purchase     Purchase?    @relation(fields: [purchaseId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, supplierId, paymentDate])
  @@index([organizationId, purchaseId])
  @@map("supplier_payments")
}

model SupplierLedgerEntry {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  supplierId        String                  @map("supplier_id") @db.Uuid
  entryType         SupplierLedgerEntryType @map("entry_type")
  direction         SupplierLedgerDirection
  amountMinor       BigInt                  @map("amount_minor")
  balanceAfterMinor BigInt                  @map("balance_after_minor")
  referenceId       String?                 @map("reference_id") @db.VarChar(128)
  referenceType     String?                 @map("reference_type") @db.VarChar(64)
  entryDate         DateTime                @map("entry_date") @db.Timestamptz(6)
  notes             String?                 @db.Text
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier     Supplier     @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, supplierId, entryDate])
  @@index([organizationId, entryType, entryDate])
  @@map("supplier_ledger_entries")
}

model CourierConsignment {
  id                   String          @id @default(uuid()) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  salesOrderId         String          @map("sales_order_id") @db.Uuid
  consignmentNumber    String          @map("consignment_number") @db.VarChar(64)
  courierProvider      CourierProvider @map("courier_provider")
  status               ShipmentStatus  @default(DRAFT)
  trackingCode         String?         @map("tracking_code") @db.VarChar(128)
  trackingUrl          String?         @map("tracking_url") @db.VarChar(500)
  codAmountMinor       Int             @default(0) @map("cod_amount_minor")
  deliveryFeeMinor     Int             @default(0) @map("delivery_fee_minor")
  recipientName        String          @map("recipient_name") @db.VarChar(160)
  recipientPhone       String          @map("recipient_phone") @db.VarChar(40)
  recipientEmail       String?         @map("recipient_email") @db.VarChar(254)
  deliveryAddressLine1 String          @map("delivery_address_line_1") @db.VarChar(240)
  deliveryAddressLine2 String?         @map("delivery_address_line_2") @db.VarChar(240)
  deliveryCity         String?         @map("delivery_city") @db.VarChar(120)
  deliveryDistrict     String?         @map("delivery_district") @db.VarChar(120)
  deliveryPostalCode   String?         @map("delivery_postal_code") @db.VarChar(120)
  itemWeightGram       Int?            @map("item_weight_gram")
  note                 String?         @db.VarChar(1000)
  dispatchedAt         DateTime?       @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt          DateTime?       @map("delivered_at") @db.Timestamptz(6)
  returnedAt           DateTime?       @map("returned_at") @db.Timestamptz(6)
  cancelledAt          DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  version              Int             @default(1)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesOrder   SalesOrder   @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@unique([organizationId, consignmentNumber])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, courierProvider, status])
  @@index([organizationId, trackingCode])
  @@map("courier_consignments")
}
