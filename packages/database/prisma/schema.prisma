  collection PaymentCollection @relation(fields: [collectionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_collection_receipts_collection_org_fkey")
  checkout PosCheckoutRecord @relation(fields: [checkoutId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_collection_receipts_checkout_org_fkey")
  salesOrder SalesOrder @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_collection_receipts_order_org_fkey")

  @@unique([id, organizationId], map: "payment_collection_receipts_id_org_key")
  @@unique([collectionId, organizationId], map: "payment_collection_receipts_collection_org_key")
  @@unique([organizationId, receiptNumber], map: "payment_collection_receipts_org_number_key")
  @@index([organizationId, collectedAt, id], map: "payment_collection_receipts_org_collected_idx")
  @@map("payment_collection_receipts")
}

model PosSaleReturn {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  checkoutId            String              @map("checkout_id") @db.Uuid
  salesOrderId          String              @map("sales_order_id") @db.Uuid
  destinationLocationId String              @map("destination_location_id") @db.Uuid
  acceptedByUserId      String              @map("accepted_by_user_id") @db.Uuid
  inventoryMovementId   String              @map("inventory_movement_id") @db.Uuid
  idempotencyKey        String              @map("idempotency_key") @db.VarChar(64)
  requestSignature      String              @map("request_signature") @db.Text
  reasonCode            PosReturnReasonCode @map("reason_code")
  reasonNote            String?             @map("reason_note") @db.VarChar(1000)
  totalCreditMinor      Int                 @map("total_credit_minor")
  returnedAt            DateTime            @map("returned_at") @db.Timestamptz(6)
  createdAt             DateTime            @map("created_at") @db.Timestamptz(6)

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  checkout            PosCheckoutRecord      @relation(fields: [checkoutId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "pos_sale_returns_checkout_org_fkey")
  salesOrder          SalesOrder             @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "pos_sale_returns_order_org_fkey")
  destinationLocation StockLocation          @relation(fields: [destinationLocationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "pos_sale_returns_destination_org_fkey")
  acceptedBy          User                   @relation(fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedMembership  OrganizationMembership @relation(fields: [acceptedByUserId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "pos_sale_returns_staff_org_fkey")
  inventoryMovement   InventoryMovement      @relation(fields: [inventoryMovementId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "pos_sale_returns_movement_org_fkey")
  lines               PosSaleReturnLine[]
  receipt             PosReturnReceipt?

  @@unique([id, organizationId], map: "pos_sale_returns_id_org_key")
  @@unique([organizationId, checkoutId, idempotencyKey], map: "pos_sale_returns_org_checkout_idem_key")
  @@unique([inventoryMovementId, organizationId], map: "pos_sale_returns_movement_org_key")
  @@index([organizationId, checkoutId, returnedAt, id], map: "pos_sale_returns_org_checkout_returned_idx")
  @@index([organizationId, salesOrderId, returnedAt], map: "pos_sale_returns_org_order_returned_idx")
  @@index([organizationId, destinationLocationId, returnedAt], map: "pos_sale_returns_org_destination_returned_idx")
  @@index([organizationId, acceptedByUserId, returnedAt], map: "pos_sale_returns_org_staff_returned_idx")
  @@map("pos_sale_returns")
}

model SalesOrderCommerceProfile {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String                     @map("organization_id") @db.Uuid
  salesOrderId      String                     @map("sales_order_id") @db.Uuid
  source            CommerceOrderSource        @default(STOREFRONT)
  paymentPreference CommercePaymentPreference  @map("payment_preference")
  requestSignature  String                     @map("request_signature") @db.Text
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesOrder   SalesOrder   @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@unique([salesOrderId, organizationId])
  @@index([organizationId, source, createdAt, id])
  @@map("sales_order_commerce_profiles")
}

model OnlinePaymentAttempt {
  id                    String                        @id @default(uuid()) @db.Uuid
  organizationId        String                        @map("organization_id") @db.Uuid
  salesOrderId          String                        @map("sales_order_id") @db.Uuid
  provider              OnlinePaymentProvider
  status                OnlinePaymentAttemptStatus    @default(CREATED)
  resolutionStatus      OnlinePaymentResolutionStatus @default(NORMAL) @map("resolution_status")
  amountMinor           Int                           @map("amount_minor")
  currencyCode          String                        @map("currency_code") @db.VarChar(3)
  idempotencyKey        String                        @map("idempotency_key") @db.VarChar(64)
  requestSignature      String                        @map("request_signature") @db.Text
  publicToken           String                        @unique(map: "online_payment_attempts_public_token_key") @map("public_token") @db.VarChar(64)
  providerTransactionId String                        @map("provider_transaction_id") @db.VarChar(64)
  providerSessionId     String?                       @map("provider_session_id") @db.VarChar(160)
  redirectUrl           String?                       @map("redirect_url") @db.VarChar(1000)
  validationId          String?                       @map("validation_id") @db.VarChar(120)
  bankTransactionId     String?                       @map("bank_transaction_id") @db.VarChar(160)
  failureCode           String?                       @map("failure_code") @db.VarChar(80)
  expiresAt             DateTime?                     @map("expires_at") @db.Timestamptz(6)
  confirmedAt           DateTime?                     @map("confirmed_at") @db.Timestamptz(6)
  version               Int                           @default(1)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesOrder     SalesOrder                @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "online_payment_attempts_order_org_fkey")
  paymentBatch   PaymentBatch?
  notifications  ProviderNotification[]
  reconciliations PaymentReconciliation[]
  refunds        ProviderRefund[]

  @@unique([id, organizationId], map: "online_payment_attempts_id_org_key")
  @@unique([organizationId, salesOrderId, idempotencyKey], map: "online_payment_attempts_org_order_idem_key")
  @@unique([organizationId, provider, providerTransactionId], map: "online_payment_attempts_org_provider_transaction_key")
  @@unique([organizationId, salesOrderId], map: "online_payment_attempts_one_success_per_order", where: { status: "SUCCEEDED" })
  @@index([organizationId, salesOrderId, createdAt, id], map: "online_payment_attempts_org_order_created_idx")
  @@index([organizationId, status, updatedAt, id], map: "online_payment_attempts_org_status_updated_idx")
  @@map("online_payment_attempts")
}

model ProviderNotification {
  id                    String                               @id @default(uuid()) @db.Uuid
  organizationId        String                               @map("organization_id") @db.Uuid
  paymentAttemptId      String                               @map("payment_attempt_id") @db.Uuid
  provider              OnlinePaymentProvider
  dedupeKey             String                               @map("dedupe_key") @db.VarChar(64)
  providerTransactionId String                               @map("provider_transaction_id") @db.VarChar(64)
  validationId          String?                              @map("validation_id") @db.VarChar(120)
  eventType             String                               @map("event_type") @db.VarChar(40)
  processingStatus      ProviderNotificationProcessingStatus @default(RECEIVED) @map("processing_status")
  errorCode             String?                              @map("error_code") @db.VarChar(80)
  receivedAt            DateTime                             @map("received_at") @db.Timestamptz(6)
  processedAt           DateTime?                            @map("processed_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentAttempt OnlinePaymentAttempt @relation(fields: [paymentAttemptId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "provider_notifications_attempt_org_fkey")

  @@unique([id, organizationId], map: "provider_notifications_id_org_key")
  @@unique([organizationId, provider, dedupeKey], map: "provider_notifications_org_provider_dedupe_key")
  @@index([organizationId, paymentAttemptId, receivedAt, id], map: "provider_notifications_org_attempt_received_idx")
  @@map("provider_notifications")
}

model PaymentReconciliation {
  id                    String                       @id @default(uuid()) @db.Uuid
  organizationId        String                       @map("organization_id") @db.Uuid
  paymentAttemptId      String                       @map("payment_attempt_id") @db.Uuid
  expectedStatus        OnlinePaymentAttemptStatus   @map("expected_status")
  observedStatus        String                       @map("observed_status") @db.VarChar(40)
  expectedAmountMinor   Int                          @map("expected_amount_minor")
  observedAmountMinor   Int?                         @map("observed_amount_minor")
  expectedCurrencyCode  String                       @map("expected_currency_code") @db.VarChar(3)
  observedCurrencyCode  String?                      @map("observed_currency_code") @db.VarChar(3)
  providerReference     String?                      @map("provider_reference") @db.VarChar(160)
  outcome               PaymentReconciliationOutcome
  reasonCode            String?                      @map("reason_code") @db.VarChar(80)
  resolvedByUserId      String?                      @map("resolved_by_user_id") @db.Uuid
  resolvedAt            DateTime?                    @map("resolved_at") @db.Timestamptz(6)
  createdAt             DateTime                     @map("created_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentAttempt OnlinePaymentAttempt @relation(fields: [paymentAttemptId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_reconciliations_attempt_org_fkey")
  resolvedBy User?                      @relation(fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedMembership OrganizationMembership? @relation(fields: [resolvedByUserId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_reconciliations_resolver_org_fkey")

  @@unique([id, organizationId], map: "payment_reconciliations_id_org_key")
  @@index([organizationId, outcome, createdAt, id], map: "payment_reconciliations_org_outcome_created_idx")
  @@index([organizationId, paymentAttemptId, createdAt, id], map: "payment_reconciliations_org_attempt_created_idx")
  @@map("payment_reconciliations")
}

model ProviderRefund {
