  @@unique([organizationId, providerRefundTransactionId], map: "provider_refunds_org_transaction_key")
  @@index([organizationId, paymentAttemptId, createdAt, id], map: "provider_refunds_org_attempt_created_idx")
  @@index([organizationId, status, updatedAt, id], map: "provider_refunds_org_status_updated_idx")
