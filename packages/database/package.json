{
  "name": "@senvo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/src/browser.js",
      "default": "./dist/src/index.js"
    }
  },
  "browser": {
    "./dist/src/index.js": "./dist/src/browser.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src prisma.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:create": "node ./scripts/require-database-url.mjs && prisma migrate dev --create-only",
    "db:migrate:deploy": "node ./scripts/require-production-database-url.mjs && prisma migrate deploy",
    "db:push:dev": "node ./scripts/require-development-db-push.mjs && prisma db push",
    "test:integration": "vitest run --fileParallelism=false src/catalog/repositories.integration.test.ts src/organization/repositories.integration.test.ts src/identity/repositories.integration.test.ts src/authentication/repositories.integration.test.ts src/authentication/customer-authentication-repository.integration.test.ts src/authorization/repositories.integration.test.ts src/audit/repositories.integration.test.ts src/transaction/prisma-transaction-manager.integration.test.ts src/inventory/repositories.integration.test.ts src/sales/repositories.integration.test.ts src/pos/repository.integration.test.ts src/procurement/stock-intake.integration.test.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('generated',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@senvo/domain": "workspace:*",
    "dotenv": "17.4.2",
    "pg": "latest",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "latest",
    "prisma": "7.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
