APP_ENV=development
DATABASE_URL=
NEXT_PUBLIC_APP_ENV=development
# Required browser API origin for Admin and Storefront applications.
NEXT_PUBLIC_SENVO_API_URL=http://localhost:4000
STOREFRONT_ORGANIZATION_CODE=SENVO
# Local development only. Production must inject an ObjectStorageProvider.
MEDIA_STORAGE_ROOT=.senvo-media

# Server-only SSLCOMMERZ hosted-payment configuration. Never expose credentials
# through NEXT_PUBLIC_* variables or browser code.
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_ENVIRONMENT=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_TIMEOUT_MS=10000
STOREFRONT_PUBLIC_BASE_URL=https://storefront.example.com
SSLCOMMERZ_IPN_URL=https://api.example.com/payments/providers/sslcommerz/ipn
# Set only for the explicit, credentialed sandbox verification command.
SSLCOMMERZ_SANDBOX_VERIFY=false
