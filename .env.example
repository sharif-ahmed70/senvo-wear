APP_ENV=development
DATABASE_URL=
NEXT_PUBLIC_APP_ENV=development
# Storefront browser API origin. Admin browser traffic is kept same-origin and
# proxied server-side by apps/admin.
NEXT_PUBLIC_SENVO_API_URL=http://localhost:4000
# Server-only upstream API origin used by the Admin workforce/session proxy.
SENVO_ADMIN_API_UPSTREAM_URL=http://localhost:4000
# Exact public origin expected by the development API for mutation/auth origin
# checks. The Admin proxy performs its own same-origin check before forwarding.
SENVO_API_ALLOWED_ORIGIN=http://localhost:3000
# Optional Admin-only override when the upstream workforce auth listener expects
# a different configured public origin.
SENVO_ADMIN_UPSTREAM_ORIGIN=
STOREFRONT_ORGANIZATION_CODE=SENVO
# Server-only customer authentication configuration.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/storefront/auth/google/callback
# Local development only. Production must inject an ObjectStorageProvider.
MEDIA_STORAGE_ROOT=.senvo-media

# Server-only SSLCOMMERZ hosted-payment configuration. Never expose credentials
# through NEXT_PUBLIC_* variables or browser code.
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_ENVIRONMENT=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_TIMEOUT_MS=10000
STOREFRONT_PUBLIC_BASE_URL=https://storefront.example.com
SSLCOMMERZ_IPN_URL=https://api.example.com/payments/providers/sslcommerz/ipn
# Set only for the explicit, credentialed sandbox verification command.
SSLCOMMERZ_SANDBOX_VERIFY=false
