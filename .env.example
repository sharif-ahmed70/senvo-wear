# SENVO Wear environment reference. Copy to .env and fill in. Placeholder values
# only: never commit real secrets. Server-only values must never be exposed via
# NEXT_PUBLIC_* variables.

# --- Core ---------------------------------------------------------------
# development | production. The production API refuses to start unless this is
# "production"; the development API refuses to start unless it is "development".
APP_ENV=development
# Browser-visible label only (currently informational). Not a secret.
NEXT_PUBLIC_APP_ENV=development
# PostgreSQL URL. Development: postgresql://postgres@127.0.0.1:5432/senvo_wear_dev
# (no password in the URL if the local server uses trust auth). Production must
# be a non-local, non-test PostgreSQL URL with a database name.
DATABASE_URL=
# Organization code the storefront sells for (must exist in the database).
STOREFRONT_ORGANIZATION_CODE=SENVO

# --- API server ---------------------------------------------------------
# Public API origin used by the Admin and Storefront browsers. Required.
NEXT_PUBLIC_SENVO_API_URL=http://localhost:4000
# API listen port. PORT wins over SENVO_API_PORT. Default 4000.
SENVO_API_PORT=4000
PORT=4000
# Listen address for the production API. Default 0.0.0.0.
HOST=0.0.0.0
# Development API only: comma-separated allowed browser origins.
SENVO_API_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Production API only (REQUIRED, comma-separated exact origins, no wildcards).
# SENVO_ADMIN_ORIGINS / SENVO_STOREFRONT_ORIGINS are accepted as aliases.
ADMIN_ORIGINS=https://admin.example.com
STOREFRONT_ORIGINS=https://storefront.example.com
# Production session cookies (optional).
# COOKIE_DOMAIN: leave empty for host-only cookies.
COOKIE_DOMAIN=
# COOKIE_SECURE: defaults to true; set "false" only for plain-HTTP local runs.
COOKIE_SECURE=true
# COOKIE_SAME_SITE: lax | strict | none. Default lax.
COOKIE_SAME_SITE=lax

# --- Authentication -----------------------------------------------------
# Server-only. Required in production: at least 32 random characters, never a
# known default. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Google login is optional. GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and
# GOOGLE_REDIRECT_URI must be set together or all left empty.
# Leave GOOGLE_REDIRECT_URI empty unless Google login is configured, otherwise
# the API will not start.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Media --------------------------------------------------------------
# Local product media folder. Absolute path required (the relative default
# resolves against each process's working directory, so API start commands
# would use different folders). Quote it if the path contains spaces.
# Production must inject an ObjectStorageProvider instead.
MEDIA_STORAGE_ROOT=C:/path/to/SENVO Wear/.senvo-media

# --- Storefront flags (browser-visible, not secrets) --------------------
# WhatsApp contact number for the storefront button, digits with country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Off by default. Customer phone/email code sign-in needs a real message sender.
NEXT_PUBLIC_STOREFRONT_CODE_SIGN_IN=false
# Off by default. The newsletter form has no backend yet.
NEXT_PUBLIC_STOREFRONT_NEWSLETTER=false

# --- Online payments (SSLCOMMERZ) ---------------------------------------
# Server-only hosted-payment configuration. Never expose credentials through
# NEXT_PUBLIC_* variables or browser code.
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_ENVIRONMENT=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_TIMEOUT_MS=10000
STOREFRONT_PUBLIC_BASE_URL=https://storefront.example.com
SSLCOMMERZ_IPN_URL=https://api.example.com/payments/providers/sslcommerz/ipn
# Set only for the explicit, credentialed sandbox verification command.
SSLCOMMERZ_SANDBOX_VERIFY=false

# --- Maintenance (development only) -------------------------------------
# Set to "local" to allow prisma db push against a local development database.
# Never in production.
# SENVO_ALLOW_DB_PUSH=local
# Test database URLs live in .env.test.example (TEST_DATABASE_URL,
# TEST_SHADOW_DATABASE_URL); they are read by the database test scripts.
